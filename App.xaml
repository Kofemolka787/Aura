<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="ColorForge.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnLastWindowClose" xmlns:colorforge="clr-namespace:ColorForge;assembly=Aura">
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="BgColor">#07070C</Color>
      <Color x:Key="PanelColor">#111019</Color>
      <Color x:Key="CardColor">#121117</Color>
      <Color x:Key="CardHoverColor">#1A1722</Color>
      <Color x:Key="StrokeColor">#34303D</Color>
      <Color x:Key="MutedColor">#9690A6</Color>
      <Color x:Key="TextColor">#F8F6FC</Color>
      <Color x:Key="AccentColor">#8D38FF</Color>
      <Color x:Key="AccentBrightColor">#C389FF</Color>
      <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
      <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
      <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentBrightBrush" Color="{StaticResource AccentBrightColor}" />
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6F38FF" Offset="0" />
        <GradientStop Color="#A931FF" Offset="0.54" />
        <GradientStop Color="#D36CFF" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="WindowGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#08070D" Offset="0" />
        <GradientStop Color="#0D0814" Offset="0.58" />
        <GradientStop Color="#170921" Offset="1" />
      </LinearGradientBrush>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
      </Style>
      <Style x:Key="CardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#E6100F15" />
        <Setter Property="BorderBrush" Value="#403A47" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="18" />
        <Setter Property="Border.Padding" Value="24" />
        <Setter Property="Margin" Value="0,0,0,16" />
      </Style>
      <Style x:Key="TweakOptionCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#E814121B" />
        <Setter Property="BorderBrush" Value="#3B3445" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,10" />
      </Style>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" CornerRadius="11" Padding="{TemplateBinding Control.Padding}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.88" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.72" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#29262F" />
        <Setter Property="BorderBrush" Value="#3A3642" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="NavButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#B0A9BF" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="176" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Padding" Value="13,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" CornerRadius="11" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.Background" Value="#2A2035" />
                  <Setter Property="Foreground" Value="#E1CCFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SceneCardButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Background" Value="#0D0D12" />
        <Setter Property="BorderBrush" Value="#302D36" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Chrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Border.BorderBrush" Value="#8D55C2" />
                  <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.94" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.78" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="QuickResolutionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinWidth" Value="128" />
        <Setter Property="Margin" Value="0,0,9,9" />
        <Setter Property="Padding" Value="17,11" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="ToggleSwitch" TargetType="{x:Type CheckBox}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <Border Name="Track" Background="#34313A" CornerRadius="13" Padding="3">
                <Ellipse Name="Dot" Width="20" Height="20" Fill="#B8B3C0" HorizontalAlignment="Left" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Border.Background" Value="#8D38FF" />
                  <Setter TargetName="Dot" Property="Shape.Fill" Value="#FFFFFFFF" />
                  <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#1A181F" />
        <Setter Property="BorderBrush" Value="#38343E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <Border Name="ComboChrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10" />
                <ContentPresenter Margin="13,0,38,0" VerticalAlignment="Center" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}" IsHitTestVisible="False" />
                <ToggleButton Focusable="False" Background="#00FFFFFF" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Grid Background="#00FFFFFF">
                        <Path Data="M0,0 L5,5 L10,0" Fill="#B5ACC2" Width="10" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                      </Grid>
                    </ControlTemplate>
                  </Control.Template>
                </ToggleButton>
                <Popup Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Focusable="False">
                  <Border Background="#17151D" BorderBrush="#494151" BorderThickness="1" CornerRadius="10" MinWidth="220" Margin="0,5,0,0" Padding="5" MaxHeight="320">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="ComboChrome" Property="Border.BorderBrush" Value="#8D4FE1" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="ComboChrome" Property="UIElement.Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
              <Border Name="ItemChrome" Background="{TemplateBinding Control.Background}" CornerRadius="7" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                  <Setter TargetName="ItemChrome" Property="Border.Background" Value="#30223F" />
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="ItemChrome" Property="Border.Background" Value="#533176" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="#141319" />
        <Setter Property="BorderBrush" Value="#35313B" />
        <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource AccentBrightBrush}" />
        <Setter Property="Padding" Value="12,8" />
      </Style>
      <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style x:Key="{x:Type Slider}" TargetType="{x:Type Slider}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Grid Margin="0,6">
                <Track Name="PART_Track">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="Slider.DecreaseLarge" BorderThickness="0" Height="5" Background="{StaticResource AccentGradient}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="{TemplateBinding Control.Background}" CornerRadius="3" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Width="17" Height="17">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                          <Ellipse Fill="#FFFFFFFF" Stroke="#8443DE" StrokeThickness="3" />
                        </ControlTemplate>
                      </Control.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="Slider.IncreaseLarge" Background="#302E34" BorderThickness="0" Height="5">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="{TemplateBinding Control.Background}" CornerRadius="3" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type DataGrid}" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="#111016" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
        <Setter Property="DataGrid.GridLinesVisibility" Value="Horizontal" />
        <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="#302C36" />
        <Setter Property="DataGrid.RowBackground" Value="#17151D" />
        <Setter Property="DataGrid.AlternatingRowBackground" Value="#1B1821" />
        <Setter Property="DataGrid.HeadersVisibility" Value="Column" />
        <Setter Property="DataGrid.RowHeight" Value="44" />
        <Setter Property="DataGrid.ColumnHeaderHeight" Value="42" />
        <Setter Property="DataGrid.RowHeaderWidth" Value="0" />
        <Setter Property="DataGrid.SelectionMode" Value="Single" />
        <Setter Property="DataGrid.SelectionUnit" Value="FullRow" />
        <Setter Property="DataGrid.CanUserResizeRows" Value="False" />
        <Setter Property="DataGrid.CanUserReorderColumns" Value="False" />
        <Setter Property="DataGrid.CanUserSortColumns" Value="False" />
      </Style>
      <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#17151C" />
        <Setter Property="Foreground" Value="#958BA3" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="BorderBrush" Value="#302B36" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type DataGridRow}" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="#131218" />
        <Setter Property="Foreground" Value="#E8E3ED" />
        <Setter Property="BorderBrush" Value="#2A2730" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DataGridRow}">
              <Border Name="RowChrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}">
                <DataGridCellsPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="RowChrome" Property="Border.Background" Value="#1C1822" />
                </Trigger>
                <Trigger Property="DataGridRow.IsSelected" Value="True">
                  <Setter TargetName="RowChrome" Property="Border.Background" Value="#2C1C39" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="#E8E3ED" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type DataGridCell}">
              <Border Background="{TemplateBinding Control.Background}" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
