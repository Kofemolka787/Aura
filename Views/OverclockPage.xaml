<UserControl x:Class="ColorForge.Views.OverclockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="OcMetric" TargetType="Border">
      <Setter Property="Background" Value="#15141B"/><Setter Property="BorderBrush" Value="#302D37"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="27,0,20,24">
    <StackPanel>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Smart auto overclock" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="  одна кнопка · реальный тест · автоматический откат" Foreground="#8F8499" FontSize="10" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="GpuTabButton" Style="{StaticResource SecondaryButton}" Content="Видеокарта" Padding="15,7" Click="GpuTab_Click"/>
          <Button x:Name="CpuTabButton" Style="{StaticResource SecondaryButton}" Content="Процессор" Padding="15,7" Margin="7,0,0,0" Click="CpuTab_Click"/>
          <Border Background="#18151E" BorderBrush="#312C39" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="7,0,0,0"><TextBlock Text="Память · не изменяется" Foreground="#756E7E" FontSize="9"/></Border>
        </StackPanel>
      </Grid>

      <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <Grid Margin="2,0,2,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HardwareNameText" Text="Определение оборудования…" FontWeight="Bold"/><Border x:Name="LiveBadge" Grid.Column="1" Background="#14271E" CornerRadius="8" Padding="9,4"><TextBlock Text="LIVE" Foreground="#63E2A0" FontSize="8" FontWeight="Bold"/></Border></Grid>
          <UniformGrid Columns="6">
            <Border Style="{StaticResource OcMetric}"><StackPanel><TextBlock Text="ТЕМПЕРАТУРА" Foreground="#817888" FontSize="8"/><TextBlock x:Name="OcTemperatureText" Text="— °C" FontSize="18" FontWeight="Bold" Foreground="#FF9A55" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource OcMetric}"><StackPanel><TextBlock Text="НАГРУЗКА" Foreground="#817888" FontSize="8"/><TextBlock x:Name="OcLoadText" Text="— %" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource OcMetric}"><StackPanel><TextBlock Text="ЧАСТОТА" Foreground="#817888" FontSize="8"/><TextBlock x:Name="OcCoreClockText" Text="— MHz" FontSize="18" FontWeight="Bold" Foreground="#9A68FF" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource OcMetric}"><StackPanel><TextBlock Text="ПАМЯТЬ" Foreground="#817888" FontSize="8"/><TextBlock x:Name="OcMemoryClockText" Text="— MHz" FontSize="18" FontWeight="Bold" Foreground="#9A68FF" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource OcMetric}"><StackPanel><TextBlock Text="МОЩНОСТЬ" Foreground="#817888" FontSize="8"/><TextBlock x:Name="OcPowerText" Text="— W" FontSize="18" FontWeight="Bold" Foreground="#4DE0BA" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource OcMetric}" Margin="0"><StackPanel><TextBlock Text="ПРОФИЛЬ" Foreground="#817888" FontSize="8"/><TextBlock x:Name="OcProfileText" Text="Stock" FontSize="18" FontWeight="Bold" Foreground="#68A8FF" Margin="0,4,0,0"/></StackPanel></Border>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}" Margin="0" Padding="18">
          <StackPanel>
            <TextBlock Text="АВТОМАТИЧЕСКИЙ РАЗГОН" FontSize="10" FontWeight="Bold" Foreground="#C493ED"/>
            <TextBlock x:Name="TuneDescriptionText" Text="AURA будет повышать частоту небольшими шагами и проверять каждый шаг." Foreground="#ACA1B5" TextWrapping="Wrap" FontSize="10" Margin="0,8,0,0"/>
            <Border x:Name="SafetyWarning" Background="#302313" BorderBrush="#624315" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,13,0,0">
              <StackPanel><TextBlock Text="⚠  Закрой всё перед запуском" Foreground="#FFC35C" FontWeight="Bold"/><TextBlock Text="Закрой игры, FACEIT/античит и тяжёлые приложения. Во время теста изображение может кратко зависнуть. При перегреве или сбое AURA сразу вернёт последнее безопасное значение." Foreground="#D5B578" TextWrapping="Wrap" FontSize="9" Margin="0,5,0,0"/></StackPanel>
            </Border>
            <Border x:Name="SupportPanel" Background="#14131A" BorderBrush="#342E3D" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0"><StackPanel><TextBlock x:Name="SupportTitleText" Text="Проверка поддержки…" FontWeight="Bold"/><TextBlock x:Name="SupportDetailText" Text="" Foreground="#8F8598" TextWrapping="Wrap" FontSize="9" Margin="0,4,0,0"/></StackPanel></Border>

            <Border Background="#16131D" BorderBrush="#3B3047" BorderThickness="1" CornerRadius="10" Padding="11,7" Margin="0,10,0,0">
              <TextBlock Text="PawnIO 2.2.0 · Modules 0.2.11 · встроены и проверяются SHA-256" Foreground="#A98DBF" FontSize="8" TextAlignment="Center"/>
            </Border>
            <Button x:Name="StartTuneButton" Style="{StaticResource PrimaryButton}" Content="⚡  Проверить и запустить авторазгон" Margin="0,12,0,0" Click="StartTune_Click"/>
            <Button x:Name="CancelTuneButton" Style="{StaticResource SecondaryButton}" Content="Остановить и вернуть Stock" Margin="0,7,0,0" Visibility="Collapsed" Click="CancelTune_Click"/>
            <ProgressBar x:Name="TuneProgress" Minimum="0" Maximum="100" Height="5" Margin="0,13,0,0"/>
            <TextBlock x:Name="TuneProgressText" Text="Готово к запуску" Foreground="#908699" FontSize="9" Margin="0,7,0,0" TextWrapping="Wrap"/>

            <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Применять найденный профиль при запуске" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Только после успешного теста" Foreground="#766F7E" FontSize="8"/></StackPanel><CheckBox x:Name="ApplyOnStartCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="ApplyOnStart_Changed" Unchecked="ApplyOnStart_Changed"/></Grid>
            <Button Style="{StaticResource SecondaryButton}" Content="Забыть найденные пределы и вернуть Stock" Margin="0,12,0,0" Click="ForgetLimits_Click"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" Padding="18">
          <Grid>
            <StackPanel x:Name="ResultEmptyPanel" VerticalAlignment="Center">
              <Image Source="pack://application:,,,/Assets/aura-mark.png" Width="90" Height="90" Opacity="0.24"/>
              <TextBlock Text="Результаты появятся здесь" HorizontalAlignment="Center" Foreground="#756D7D" Margin="0,12,0,0"/>
              <TextBlock Text="после автоматической проверки частот и температуры" HorizontalAlignment="Center" Foreground="#504B56" FontSize="9" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
              <Border Background="#171020" BorderBrush="#67418A" BorderThickness="1" CornerRadius="15" Padding="18">
                <StackPanel><TextBlock Text="РЕЗУЛЬТАТ SMART TUNE" Foreground="#C493ED" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="ResultTitleText" Text="Стабильное ядро +90 MHz" FontSize="22" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="ResultDetailText" Foreground="#A094A9" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/></StackPanel>
              </Border>
              <UniformGrid Columns="2" Margin="0,12,0,0">
                <Border Background="#14131A" BorderBrush="#302C36" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="ПИКОВАЯ ТЕМПЕРАТУРА" Foreground="#766F7E" FontSize="8"/><TextBlock x:Name="ResultTemperatureText" Text="0 °C" FontSize="21" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="#14131A" BorderBrush="#302C36" BorderThickness="1" CornerRadius="12" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="ОЦЕНКА ПРИРОСТА" Foreground="#766F7E" FontSize="8"/><TextBlock x:Name="ResultGainText" Text="0%" FontSize="21" FontWeight="Bold" Foreground="#63E2A0" Margin="0,4,0,0"/></StackPanel></Border>
              </UniformGrid>
              <Border Background="#13271F" BorderBrush="#26533B" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,12,0,0"><TextBlock Text="✓  Профиль прошёл короткую проверку AURA. Это снижает риск, но не заменяет длительный стресс-тест. При артефактах, WHEA или сбое драйвера сразу верни Stock." Foreground="#70DFA5" TextWrapping="Wrap" FontSize="9"/></Border>
              <Border Background="#15131B" CornerRadius="12" Padding="13" Margin="0,10,0,0"><TextBlock x:Name="FaceitNoteText" Text="Перед FACEIT: закрой AURA и перезагрузи компьютер, если античит сообщает о несовместимом аппаратном драйвере. AURA не пытается обходить античит." Foreground="#AFA2B8" TextWrapping="Wrap" FontSize="9"/></Border>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
