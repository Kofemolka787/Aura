<UserControl x:Class="ColorForge.Views.BiosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="BiosCard" TargetType="Border">
      <Setter Property="Background" Value="#131218"/><Setter Property="BorderBrush" Value="#322E39"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="27,0,20,24">
    <StackPanel>
      <Border Style="{StaticResource CardStyle}" Padding="20">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="46" Height="46" CornerRadius="14" Background="{StaticResource AccentGradient}"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="BIOS GUIDE" Foreground="#C999F1" FontSize="10" FontWeight="Bold"/><TextBlock Text="Оптимизация UEFI для игр" FontSize="19" FontWeight="Bold" Margin="0,3,0,0"/><TextBlock Text="Рекомендации для ASUS TUF A520M-PLUS · значения проверяй перед сохранением." Foreground="#91869B" FontSize="10" Margin="0,4,0,0"/></StackPanel>
          <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Перезагрузить в UEFI" Padding="17,9" Click="RestartToFirmware_Click"/>
        </Grid>
      </Border>

      <Border Background="#2E2111" BorderBrush="#614619" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,0,14">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⚠" Foreground="#FFC45F" FontSize="18"/><StackPanel Grid.Column="1"><TextBlock Text="AURA не записывает эти параметры автоматически" Foreground="#FFD17D" FontWeight="Bold"/><TextBlock Text="UEFI каждой платы устроен по-разному, а неверная запись может сорвать загрузку. Кнопка выше только открывает прошивку после подтверждения; меняешь значения ты сам. Перед началом сохрани текущий профиль BIOS." Foreground="#CDAE7D" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource BiosCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SMT Control" FontSize="15" FontWeight="Bold"/><Border Grid.Column="1" Background="#1C1730" CornerRadius="8" Padding="9,4"><TextBlock Text="ENABLE" Foreground="#C597FF" FontWeight="Bold" FontSize="9"/></Border></Grid><TextBlock Text="Оставляет два потока на ядро — это лучший универсальный вариант для современных игр и фоновых задач." Foreground="#93899D" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="Advanced → AMD CBS → CPU Common Options → SMT Control" Foreground="#6F6678" FontStyle="Italic" FontSize="9" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource BiosCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="DOCP / XMP" FontSize="15" FontWeight="Bold"/><Border Grid.Column="1" Background="#1C1730" CornerRadius="8" Padding="9,4"><TextBlock Text="ENABLE" Foreground="#C597FF" FontWeight="Bold" FontSize="9"/></Border></Grid><TextBlock Text="Включает паспортную частоту и тайминги памяти. После включения проверь стабильность отдельным тестом RAM." Foreground="#93899D" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="Ai Tweaker → Ai Overclock Tuner → D.O.C.P." Foreground="#6F6678" FontStyle="Italic" FontSize="9" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource BiosCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SVM Mode" FontSize="15" FontWeight="Bold"/><Border Grid.Column="1" Background="#302313" CornerRadius="8" Padding="9,4"><TextBlock Text="ПО СИТУАЦИИ" Foreground="#FFC45F" FontWeight="Bold" FontSize="9"/></Border></Grid><TextBlock Text="Disable только если не используешь Hyper-V, WSL2, Docker, виртуальные машины, Sandbox и эмуляторы Android." Foreground="#93899D" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="Advanced → CPU Configuration → SVM Mode" Foreground="#6F6678" FontStyle="Italic" FontSize="9" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource BiosCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PCIe ASPM" FontSize="15" FontWeight="Bold"/><Border Grid.Column="1" Background="#1C1730" CornerRadius="8" Padding="9,4"><TextBlock Text="DISABLE" Foreground="#C597FF" FontWeight="Bold" FontSize="9"/></Border></Grid><TextBlock Text="Убирает энергосберегающие переходы PCIe, которые иногда дают микрозадержки. Повысит расход энергии в простое." Foreground="#93899D" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="Advanced → PCI Subsystem Settings → PCI Express ASPM" Foreground="#6F6678" FontStyle="Italic" FontSize="9" Margin="0,8,0,0"/></StackPanel></Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource BiosCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Global C-State Control" FontSize="15" FontWeight="Bold"/><Border Grid.Column="1" Background="#302313" CornerRadius="8" Padding="9,4"><TextBlock Text="AUTO" Foreground="#FFC45F" FontWeight="Bold" FontSize="9"/></Border></Grid><TextBlock Text="Начни с Auto. Disable имеет смысл только при измеренной проблеме с задержками и заметно повышает потребление в простое." Foreground="#93899D" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="Advanced → AMD CBS → CPU Common Options" Foreground="#6F6678" FontStyle="Italic" FontSize="9" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource BiosCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Power Supply Idle Control" FontSize="15" FontWeight="Bold"/><Border Grid.Column="1" Background="#1C1730" CornerRadius="8" Padding="9,4"><TextBlock Text="TYPICAL" Foreground="#C597FF" FontWeight="Bold" FontSize="9"/></Border></Grid><TextBlock Text="Typical Current Idle помогает избежать редких зависаний и холодных стартов на некоторых Ryzen-системах." Foreground="#93899D" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="Advanced → AMD CBS → CPU Common Options" Foreground="#6F6678" FontStyle="Italic" FontSize="9" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource BiosCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Above 4G Decoding" FontSize="15" FontWeight="Bold"/><Border Grid.Column="1" Background="#1C1730" CornerRadius="8" Padding="9,4"><TextBlock Text="ENABLE" Foreground="#C597FF" FontWeight="Bold" FontSize="9"/></Border></Grid><TextBlock Text="Нужно для 64-битной адресации PCIe и является обязательной основой для Resizable BAR." Foreground="#93899D" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="Advanced → PCI Subsystem Settings → Above 4G Decoding" Foreground="#6F6678" FontStyle="Italic" FontSize="9" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource BiosCard}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Re-Size BAR Support" FontSize="15" FontWeight="Bold"/><Border Grid.Column="1" Background="#1C1730" CornerRadius="8" Padding="9,4"><TextBlock Text="ENABLE" Foreground="#C597FF" FontWeight="Bold" FontSize="9"/></Border></Grid><TextBlock Text="Разрешает CPU обращаться к большему диапазону видеопамяти. Требуются совместимые GPU, VBIOS, материнская плата и драйвер." Foreground="#93899D" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="Advanced → PCI Subsystem Settings → Re-Size BAR Support" Foreground="#6F6678" FontStyle="Italic" FontSize="9" Margin="0,8,0,0"/></StackPanel></Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
