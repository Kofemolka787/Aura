                      <TextBlock Text="ЗАПУСК И ПОВЕДЕНИЕ" FontSize="10" FontWeight="Bold" Foreground="#C4A2DD" Margin="0,0,0,12" />
                      <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="27" Height="27" CornerRadius="8" Background="#291C35">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#C98EFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="Запускать с Windows" FontWeight="SemiBold" />
                          <TextBlock Text="AURA готова сразу после входа" Foreground="#817888" FontSize="9" />
                        </StackPanel>
                        <CheckBox Name="StartupCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Checked="Startup_Changed" Unchecked="Startup_Changed" />
                      </Grid>
                      <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="27" Height="27" CornerRadius="8" Background="#291C35">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#C98EFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="Сворачивать в трей" FontWeight="SemiBold" />
                          <TextBlock Text="Работает тихо в фоне" Foreground="#817888" FontSize="9" />
                        </StackPanel>
                        <CheckBox Name="TrayCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Checked="Settings_Changed" Unchecked="Settings_Changed" />
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="27" Height="27" CornerRadius="8" Background="#291C35">
                          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#C98EFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="Применять профиль при запуске" FontWeight="SemiBold" />
                          <TextBlock Text="Восстановить цвет выбранного монитора" Foreground="#817888" FontSize="9" />
                        </StackPanel>
                        <CheckBox Name="ApplyOnStartCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Checked="Effects_Changed" Unchecked="Effects_Changed" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18">
                    <StackPanel>
                      <TextBlock Text="БЕЗОПАСНЫЙ СБРОС" FontSize="10" FontWeight="Bold" Foreground="#C4A2DD" />
                      <TextBlock Text="Возвращает стандартные цвета только на выбранном мониторе." Foreground="#817888" TextWrapping="Wrap" Margin="0,7,0,14" />
                      <Button Style="{StaticResource PrimaryButton}" Content="↻  Сбросить выбранный монитор" HorizontalAlignment="Left" Padding="16,8" Click="Reset_Click" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Border Style="{StaticResource CardStyle}" Margin="0" Padding="18">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ГРАФИКА И МОНИТОР" FontSize="10" FontWeight="Bold" Foreground="#C4A2DD" />
                        <Border Grid.Column="1" Background="#15231D" CornerRadius="8" Padding="8,4">
                          <TextBlock Text="●  АКТИВНО" Foreground="#65DF9A" FontSize="8" FontWeight="Bold" />
                        </Border>
                      </Grid>
                      <TextBlock Name="SelectedMonitorSettingsText" Text="Монитор 1" FontSize="17" FontWeight="SemiBold" Margin="0,15,0,5" />
                      <TextBlock Name="NvidiaStatusText" Foreground="#65D69B" TextWrapping="Wrap" FontSize="10" />
                      <Button Style="{StaticResource SecondaryButton}" Content="Открыть настройки HDR" HorizontalAlignment="Left" Padding="15,8" Margin="0,15,0,0" Click="OpenHdr_Click" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18">
                    <StackPanel>
                      <TextBlock Text="ИГРОВОЙ ОВЕРЛЕЙ И КЛАВИШИ" FontWeight="Bold" Foreground="#C4A2DD" />
                      <Button Style="{StaticResource SecondaryButton}" Content="Настроить общий оверлей" Click="OverlaySettings_Click" Margin="0,12,0,8" />
                      <Button Style="{StaticResource SecondaryButton}" Content="Глобальные горячие клавиши" Click="HotkeysSettings_Click" />
                      <TextBlock Name="HotkeyStatusText" Text="Ожидание регистрации" TextWrapping="Wrap" Foreground="#91869B" FontSize="10" Margin="0,10,0,0" />
                      <TextBlock Text="FPS использует активную карточку игры или выбранный процесс в диагностике. Показывается окно последних кадров, а не полный замер." TextWrapping="Wrap" Foreground="#817888" FontSize="10" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18">
                    <StackPanel>
                      <TextBlock Text="ДАННЫЕ AURA" FontSize="10" FontWeight="Bold" Foreground="#C4A2DD" />
                      <TextBlock Text="Файл настроек" Foreground="#817888" FontSize="9" Margin="0,13,0,5" />
                      <Border Background="#121017" CornerRadius="9" Padding="10">
                        <TextBlock Name="SettingsPathText" Foreground="#BEB3C7" TextWrapping="Wrap" FontSize="9" />
                      </Border>
                      <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SecondaryButton}" Content="Открыть папку" Padding="10,7" Click="OpenSettingsFolder_Click" />
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Копировать путь" Padding="10,7" Click="CopySettingsPath_Click" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="15">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="42" Height="42" CornerRadius="12" Background="#171020" BorderBrush="#563972" BorderThickness="1">
                        <Image Source="pack://application:,,,/Assets/aura-mark.png" Margin="5" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Name="SettingsAccountEmailText" Text="demo@aura.app" FontWeight="Bold" />
                        <TextBlock Name="SettingsSubscriptionText" Text="AURA · 30 дней" Foreground="#70DDA1" FontSize="9" Margin="0,2,0,0" />
                          <Button Style="{StaticResource SecondaryButton}" Content="Проверить обновления" Click="CheckUpdates_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <Border Background="#2B1C39" CornerRadius="8" Padding="9,4" HorizontalAlignment="Right">
                          <TextBlock Text="v0.12" Foreground="#D5B4EF" FontSize="9" FontWeight="Bold" />
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}" Content="Выйти" Padding="12,5" MinHeight="30" Margin="0,7,0,0" Click="Logout_Click" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
