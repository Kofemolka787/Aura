          <Button Content="□" Width="46" Background="#00FFFFFF" Foreground="#B7ADBD" BorderThickness="0" Click="Maximize_Click" />
          <Button Content="×" Width="46" Background="#00FFFFFF" Foreground="#B7ADBD" BorderThickness="0" Click="Close_Click" />
        </StackPanel>
      </Grid>
      <Grid Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="206" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#D90F0C16" BorderBrush="#37303F" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="88" />
              <RowDefinition Height="*" />
              <RowDefinition Height="72" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
              <Border Width="52" Height="52" CornerRadius="15" Background="#140E1E" BorderBrush="#56327B" BorderThickness="1">
                <Image Source="pack://application:,,,/Assets/aura-mark.png" Margin="5" Stretch="Uniform" />
              </Border>
              <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="AURA" FontWeight="Black" FontSize="18" />
                <TextBlock Text="DISPLAY LAB" FontSize="8" FontWeight="Bold" Foreground="#9C83B6" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,0">
              <Button Name="NavDisplay" Style="{StaticResource NavButton}" Tag="Display" Background="#432C59" BorderBrush="#8250B2" Foreground="#FFFFFF" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                  <TextBlock Text="Дисплей" />
                </StackPanel>
              </Button>
              <Button Name="NavCrosshair" Style="{StaticResource NavButton}" Tag="Crosshair" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                  <TextBlock Text="Прицел" />
                </StackPanel>
              </Button>
              <Button Name="NavGames" Style="{StaticResource NavButton}" Tag="Games" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                  <TextBlock Text="Автопрофили" />
                </StackPanel>
              </Button>
              <Button Name="NavDiagnostics" Style="{StaticResource NavButton}" Tag="Diagnostics" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                  <TextBlock Text="Диагностика" />
                </StackPanel>
              </Button>
              <Button Name="NavOverclock" Style="{StaticResource NavButton}" Tag="Overclock" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                  <TextBlock Text="Разгон" />
                </StackPanel>
              </Button>
              <Button Name="NavTweaks" Style="{StaticResource NavButton}" Tag="Tweaks" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                  <TextBlock Text="Твики Windows" />
                </StackPanel>
              </Button>
              <Button Name="NavBios" Style="{StaticResource NavButton}" Tag="Bios" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                  <TextBlock Text="BIOS Guide" />
                </StackPanel>
              </Button>
              <Button Name="NavSettings" Style="{StaticResource NavButton}" Tag="Settings" Click="Nav_Click">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" />
                  <TextBlock Text="Настройки" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Border Grid.Row="2" Margin="14,9,14,13" CornerRadius="12" Background="#17131D" BorderBrush="#302938" BorderThickness="1">
              <Grid Margin="11,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid>
                  <Ellipse Width="25" Height="25" Fill="{StaticResource AccentGradient}" />
                  <Ellipse Width="8" Height="8" Fill="#65E69B" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="#17131D" StrokeThickness="2" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                  <TextBlock Name="AccountNameText" Text="AURA User" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Name="SubscriptionText" Text="подписка активна" FontSize="9" Foreground="#72DDA2" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
        <Grid Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Row="0" Margin="27,13,27,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Name="PageTitle" Text="Дисплей" FontSize="28" FontWeight="Bold" />
              <TextBlock Name="PageSubtitle" Text="Один активный монитор · профили и разрешение переключаются вместе" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Background="#1A171F" BorderBrush="#39343F" BorderThickness="1" CornerRadius="11" Margin="0,0,9,0" Padding="11,6">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Name="StatusDot" Fill="#62D69B" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <TextBlock Name="StatusText" Text="Готово" FontSize="11" Foreground="#D8CDE0" VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <ComboBox Name="MonitorCombo" Width="205" SelectionChanged="MonitorCombo_SelectionChanged" />
            </StackPanel>
          </Grid>
          <Grid Name="DisplayPage" Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="27,0,20,24">
              <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <Grid Margin="0,0,0,13">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="ЦВЕТ" FontSize="10" FontWeight="Bold" Foreground="#B59ACF" />
                        <TextBlock Text="Аппаратная настройка выбранного монитора" FontSize="11" Foreground="#827B8B" Margin="0,4,0,0" />
                      </StackPanel>
                      <CheckBox Name="EffectsEnabledCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Checked="Effects_Changed" Unchecked="Effects_Changed" />
                    </Grid>
                    <controls:SliderField x:Name="BrightnessField" Title="Яркость" Minimum="-50" Maximum="50" Value="0" />
                    <controls:SliderField x:Name="ContrastField" Title="Контраст" Minimum="50" Maximum="150" Value="100" Suffix="%" />
                    <controls:SliderField x:Name="SaturationField" Title="Насыщенность" Minimum="0" Maximum="220" Value="100" Suffix="%" />
                    <controls:SliderField x:Name="GammaField" Title="Гамма" Minimum="50" Maximum="200" Value="100" Suffix="%" />
                    <controls:SliderField x:Name="TemperatureField" Title="Температура" Minimum="3000" Maximum="10000" Value="6500" Suffix=" K" />
                    <Grid Margin="0,13,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                      </Grid.ColumnDefinitions>
                      <Button Style="{StaticResource SecondaryButton}" Content="↻  Сбросить монитор" Padding="17,8" Click="Reset_Click" />
                      <TextBlock Grid.Column="1" Text="Другие дисплеи не изменяются" Foreground="#77717F" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel>
                      <controls:SliderField x:Name="VibranceField" Title="Digital Vibrance" Minimum="0" Maximum="100" Value="50" />
                      <controls:SliderField x:Name="ShadowsField" Title="Shadows" Minimum="0" Maximum="100" Value="0" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Padding="16,18,4,8">
                  <StackPanel>
                    <Grid Margin="8,0,12,12">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="СЦЕНЫ И РЕЖИМЫ" FontSize="10" FontWeight="Bold" Foreground="#B59ACF" />
                        <TextBlock Text="Клик — профиль сразу применяется к выбранному монитору" FontSize="11" Foreground="#827B8B" Margin="0,4,0,0" />
                      </StackPanel>
                      <TextBlock Name="ActiveSceneText" Grid.Column="1" Text="AURA · Зима" FontSize="11" FontWeight="SemiBold" Foreground="#C791FF" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Иллюстрации сцен · не точный предпросмотр цвета монитора" Foreground="#817888" FontSize="9" Margin="0,0,0,8"/>
                    <UniformGrid Name="ScenesPanel" Columns="3">
                      <Button Name="ModeWinter" Style="{StaticResource SceneCardButton}" Tag="AURA · Зима" Margin="0,0,12,12" Click="ScenePreset_Click">
                        <StackPanel>
                          <TextBlock Text="ЗИМА" FontSize="10" FontWeight="Bold" Foreground="#C8AFDF" Margin="12,10,12,8" />
                          <Border Height="116" CornerRadius="10" Margin="8,0,8,8" ClipToBounds="True">
                            <Border.Background>
                              <ImageBrush ImageSource="pack://application:,,,/Assets/rust-scenes.png" ViewboxUnits="Absolute" Viewbox="41,94,234,132" Stretch="UniformToFill" />
                            </Border.Background>
                          </Border>
                        </StackPanel>
                      </Button>
                      <Button Name="ModeNight" Style="{StaticResource SceneCardButton}" Tag="AURA · Ночь" Margin="0,0,12,12" Click="ScenePreset_Click">
                        <StackPanel>
                          <TextBlock Text="НОЧЬ" FontSize="10" FontWeight="Bold" Foreground="#C8AFDF" Margin="12,10,12,8" />
                          <Border Height="116" CornerRadius="10" Margin="8,0,8,8" ClipToBounds="True">
                            <Border.Background>
                              <ImageBrush ImageSource="pack://application:,,,/Assets/rust-scenes.png" ViewboxUnits="Absolute" Viewbox="288,94,233,132" Stretch="UniformToFill" />
                            </Border.Background>
                          </Border>
                        </StackPanel>
                      </Button>
                      <Button Name="ModeDesert" Style="{StaticResource SceneCardButton}" Tag="AURA · Пустыня" Margin="0,0,12,12" Click="ScenePreset_Click">
                        <StackPanel>
                          <TextBlock Text="ПУСТЫНЯ" FontSize="10" FontWeight="Bold" Foreground="#C8AFDF" Margin="12,10,12,8" />
                          <Border Height="116" CornerRadius="10" Margin="8,0,8,8" ClipToBounds="True">
                            <Border.Background>
                              <ImageBrush ImageSource="pack://application:,,,/Assets/rust-scenes.png" ViewboxUnits="Absolute" Viewbox="535,94,234,132" Stretch="UniformToFill" />
                            </Border.Background>
                          </Border>
                        </StackPanel>
                      </Button>
                      <Button Name="ModeJungle" Style="{StaticResource SceneCardButton}" Tag="AURA · Джунгли" Margin="0,0,12,12" Click="ScenePreset_Click">
                        <StackPanel>
                          <TextBlock Text="ДЖУНГЛИ" FontSize="10" FontWeight="Bold" Foreground="#C8AFDF" Margin="12,10,12,8" />
                          <Border Height="116" CornerRadius="10" Margin="8,0,8,8" ClipToBounds="True">
                            <Border.Background>
                              <ImageBrush ImageSource="pack://application:,,,/Assets/rust-scenes.png" ViewboxUnits="Absolute" Viewbox="41,269,234,133" Stretch="UniformToFill" />
                            </Border.Background>
                          </Border>
                        </StackPanel>
                      </Button>
                      <Button Name="ModeGreen" Style="{StaticResource SceneCardButton}" Tag="AURA · Зелёнка" Margin="0,0,12,12" Click="ScenePreset_Click">
                        <StackPanel>
                          <TextBlock Text="ЗЕЛЁНКА" FontSize="10" FontWeight="Bold" Foreground="#C8AFDF" Margin="12,10,12,8" />
                          <Border Height="116" CornerRadius="10" Margin="8,0,8,8" ClipToBounds="True">
                            <Border.Background>
                              <ImageBrush ImageSource="pack://application:,,,/Assets/rust-scenes.png" ViewboxUnits="Absolute" Viewbox="288,269,233,133" Stretch="UniformToFill" />
                            </Border.Background>
                          </Border>
                        </StackPanel>
                      </Button>
                      <Button Name="ModeMetro" Style="{StaticResource SceneCardButton}" Tag="AURA · Метро" Margin="0,0,12,12" Click="ScenePreset_Click">
                        <StackPanel>
                          <TextBlock Text="МЕТРО" FontSize="10" FontWeight="Bold" Foreground="#C8AFDF" Margin="12,10,12,8" />
                          <Border Height="116" CornerRadius="10" Margin="8,0,8,8" ClipToBounds="True">
                            <Border.Background>
                              <ImageBrush ImageSource="pack://application:,,,/Assets/rust-scenes.png" ViewboxUnits="Absolute" Viewbox="535,269,234,133" Stretch="UniformToFill" />
                            </Border.Background>
                          </Border>
                        </StackPanel>
                      </Button>
                      <Button Name="ModeCs2" Style="{StaticResource SceneCardButton}" Tag="AURA · CS2" Margin="0,0,12,12" Click="ScenePreset_Click">
                        <StackPanel>
                          <TextBlock Text="CS2 · COMPETITIVE" FontSize="10" FontWeight="Bold" Foreground="#FFB57B" Margin="12,10,12,8" />
                          <Border Height="116" CornerRadius="10" Margin="8,0,8,8" ClipToBounds="True">
                            <Grid>
                              <Image Source="pack://application:,,,/Assets/cs2-mode.png" Stretch="UniformToFill" />
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition />
                                  <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Background="#6B070911" />
                                <Border Grid.Column="1" BorderBrush="#D8FFFFFF" BorderThickness="1,0,0,0" />
                              </Grid>
                            </Grid>
                          </Border>
                        </StackPanel>
                      </Button>
                      <Button Name="ModeDota" Style="{StaticResource SceneCardButton}" Tag="AURA · Dota 2" Margin="0,0,12,12" Click="ScenePreset_Click">
                        <StackPanel>
                          <TextBlock Text="DOTA 2 · TEAMFIGHT" FontSize="10" FontWeight="Bold" Foreground="#84D8FF" Margin="12,10,12,8" />
                          <Border Height="116" CornerRadius="10" Margin="8,0,8,8" ClipToBounds="True">
                            <Grid>
                              <Image Source="pack://application:,,,/Assets/dota2-mode.png" Stretch="UniformToFill" />
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition />
                                  <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Background="#5A090A10" />
                                <Border Grid.Column="1" BorderBrush="#D8FFFFFF" BorderThickness="1,0,0,0" />
                              </Grid>
                            </Grid>
                          </Border>
                        </StackPanel>
                      </Button>
                      <Button Name="ModeCinema" Style="{StaticResource SceneCardButton}" Tag="AURA · Кино" Margin="0,0,12,12" Click="ScenePreset_Click">
                        <StackPanel>
                          <TextBlock Text="КИНО · CINEMA" FontSize="10" FontWeight="Bold" Foreground="#FFCB8C" Margin="12,10,12,8" />
                          <Border Height="116" CornerRadius="10" Margin="8,0,8,8" ClipToBounds="True">
                            <Grid>
                              <Image Source="pack://application:,,,/Assets/cinema-mode.png" Stretch="UniformToFill" />
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition />
                                  <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Background="#5A08080F" />
                                <Border Grid.Column="1" BorderBrush="#D8FFFFFF" BorderThickness="1,0,0,0" />
                              </Grid>
                            </Grid>
                          </Border>
                        </StackPanel>
                      </Button>
                    </UniformGrid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Text="МОИ ПРОФИЛИ" FontSize="10" FontWeight="Bold" Foreground="#B59ACF"/>
                    <ComboBox x:Name="ProfileCombo" DisplayMemberPath="Name" Margin="0,8,0,8" SelectionChanged="ProfileCombo_Changed"/>
                    <WrapPanel>
                      <Button Style="{StaticResource SecondaryButton}" Content="Сохранить как новый" Margin="0,0,7,7" Click="SaveProfileAs_Click"/>
                      <Button Style="{StaticResource SecondaryButton}" Content="Обновить профиль" Margin="0,0,7,7" Click="UpdateProfile_Click"/>
                      <Button Style="{StaticResource SecondaryButton}" Content="Переименовать" Margin="0,0,7,7" Click="RenameProfile_Click"/>
                      <Button Style="{StaticResource SecondaryButton}" Content="Удалить" Margin="0,0,7,7" Click="DeleteProfile_Click"/>
                      <Button Style="{StaticResource SecondaryButton}" Content="Импорт JSON" Margin="0,0,7,7" Click="ImportProfiles_Click"/>
                      <Button Style="{StaticResource SecondaryButton}" Content="Экспорт JSON" Margin="0,0,7,7" Click="ExportProfiles_Click"/>
                    </WrapPanel>
                    <TextBlock Text="Встроенные сцены сохраняются отдельно как пользовательские профили. Изображения сцен — иллюстрации." Foreground="#91869B" FontSize="9" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Text="РАЗРЕШЕНИЕ" FontSize="10" FontWeight="Bold" Foreground="#B59ACF" />
                    <TextBlock Text="Быстрые режимы для выбранного монитора" FontSize="11" Foreground="#827B8B" Margin="0,4,0,14" />
                    <WrapPanel>
                      <Button Style="{StaticResource QuickResolutionButton}" Content="1920 × 1080" Tag="1920x1080" Click="QuickResolution_Click" />
                      <Button Style="{StaticResource QuickResolutionButton}" Content="1280 × 1080" Tag="1280x1080" Click="QuickResolution_Click" />
                      <Button Style="{StaticResource QuickResolutionButton}" Content="1280 × 1024" Tag="1280x1024" Click="QuickResolution_Click" />
                      <Button Style="{StaticResource QuickResolutionButton}" Content="1440 × 1080" Tag="1440x1080" Click="QuickResolution_Click" />
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                      <TextBox Name="CustomWidthBox" Width="92" Text="1920" TextAlignment="Center" Margin="0,0,7,0" ToolTip="Ширина" />
                      <TextBlock Text="×" VerticalAlignment="Center" Foreground="#817A89" Margin="0,0,7,0" />
                      <TextBox Name="CustomHeightBox" Width="92" Text="1080" TextAlignment="Center" Margin="0,0,7,0" ToolTip="Высота" />
                      <TextBlock Text="@" VerticalAlignment="Center" Foreground="#817A89" Margin="0,0,7,0" />
                      <TextBox Name="CustomHzBox" Width="74" Text="144" TextAlignment="Center" Margin="0,0,9,0" ToolTip="Гц" />
                      <Button Style="{StaticResource SecondaryButton}" Content="Задать" Padding="20,8" Margin="0,0,9,0" Click="ApplyCustomMode_Click" />
                      <ComboBox Name="DisplayModeCombo" Width="250" Margin="0,0,9,0" />
                      <Button Style="{StaticResource SecondaryButton}" Content="Применить из списка" Padding="16,8" Click="ApplyDisplayMode_Click" />
                    </WrapPanel>
                    <Border Background="#15121A" BorderBrush="#342C3C" BorderThickness="1" CornerRadius="13" Padding="13" Margin="0,13,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="38" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="29" Height="29" CornerRadius="9" Background="#322044">
                          <TextBlock Text="↔" Foreground="#D098FF" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="РАСТЯГИВАНИЕ ВО ВЕСЬ ЭКРАН" FontSize="10" FontWeight="Bold" Foreground="#D3B2EC" />
                          <TextBlock Text="Заполняет монитор целиком — без чёрных полос по бокам" FontSize="10" Foreground="#817888" Margin="0,3,0,0" />
                        </StackPanel>
                        <CheckBox Name="StretchScalingCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Margin="14,0" VerticalAlignment="Center" Checked="Scaling_Changed" Unchecked="Scaling_Changed" />
                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Применить сейчас" Padding="14,7" Click="ApplyScaling_Click" />
                      </Grid>
                    </Border>
                    <TextBlock Name="ScalingStatusText" Text="AURA запросит у Windows растянутое масштабирование после смены режима. Драйвер видеокарты должен поддерживать GPU scaling." Foreground="#6F6977" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
