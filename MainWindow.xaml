                  <Border>
                    <Border.Background>
                      <ImageBrush ImageSource="pack://application:,,,/Assets/rust-scenes.png" ViewboxUnits="Absolute" Viewbox="288,269,233,133" Stretch="UniformToFill" />
                    </Border.Background>
                  </Border>
                  <Rectangle>
                    <Shape.Fill>
                      <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#05000000" />
                        <GradientStop Color="#D80A0810" Offset="1" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Rectangle>
                  <StackPanel VerticalAlignment="Bottom" Margin="14">
                    <TextBlock Text="RUST" FontWeight="Black" FontSize="18" />
