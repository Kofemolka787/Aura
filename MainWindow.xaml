              <RowDefinition Height="168" />
              <RowDefinition Height="14" />
              <RowDefinition />
              <RowDefinition Height="68" />
            </Grid.RowDefinitions>
            <UniformGrid Columns="3">
              <Button Style="{StaticResource SceneCardButton}" Tag="RustClient" Margin="0,0,10,0" Click="GamePresetCard_Click">
