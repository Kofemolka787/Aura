<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ColorForge.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ColorForge.Controls" xmlns:views="clr-namespace:ColorForge.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="AURA" Icon="pack://application:,,,/Assets/aura-mark.png" Width="1180" Height="790" MinWidth="1000" MinHeight="690" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource WindowGradient}" FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True" xmlns:colorforge="clr-namespace:ColorForge">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="7" CornerRadius="12" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#4A2C5E" BorderThickness="1" CornerRadius="12" Background="{StaticResource WindowGradient}" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Row="0" Background="#F00A0910" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="138" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
          <Image Source="pack://application:,,,/Assets/aura-mark.png" Width="26" Height="26" Stretch="Uniform" />
          <TextBlock Text="AURA" FontWeight="Black" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Border Background="#2E203B" CornerRadius="8" Margin="9,0,0,0" Padding="8,3">
            <TextBlock Text="v0.12" FontSize="10" Foreground="#D5B7FF" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
