<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ColorForge.Controls.SliderField" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" MinHeight="42" xmlns:controls="clr-namespace:ColorForge.Controls;assembly=Aura">
  <Grid Margin="0,2">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="126" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="74" />
    </Grid.ColumnDefinitions>
    <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#E4DDEB" Text="{Binding Title, ElementName=Root}" />
    <Slider Name="ValueSlider" Grid.Column="1" Margin="2,0,12,0" TickFrequency="1" IsSnapToTickEnabled="True" Minimum="{Binding Minimum, ElementName=Root}" Maximum="{Binding Maximum, ElementName=Root}" Value="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFFFFF">
      <Run Text="{Binding Value, ElementName=Root, Mode=OneWay}" />
      <Run Text="{Binding Suffix, ElementName=Root}" />
    </TextBlock>
  </Grid>
</UserControl>